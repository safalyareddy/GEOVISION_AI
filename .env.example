# GeoVision AI — Environment Configuration Template
# Copy this file to .env and adjust variables for your local or deployment environment.

# API Service Configuration
PORT=8000
API_HOST=0.0.0.0
DEBUG=false

# Streamlit Frontend Configuration
API_URL=http://localhost:8000

# Model Paths & Runtime Device
DEFAULT_MODEL=unet_plusplus
DEVICE=mps  # Options: 'cpu', 'cuda', 'mps'

# MLflow Experiment Tracking (Optional)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
